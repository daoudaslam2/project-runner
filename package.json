{
  "name": "universal-project-runner",
  "displayName": "Universal Project Runner",
  "description": "Run projects from VS Code using configurable project commands.",
  "version": "0.2.0",
  "publisher": "daoudaslam",
  "icon": "resources/project-runner.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/daoudaslam2/universal-project-runner"
  },
  "bugs": {
    "url": "https://github.com/daoudaslam2/universal-project-runner/issues"
  },
  "homepage": "https://github.com/daoudaslam2/universal-project-runner#readme",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:project-runner.runProject",
    "onCommand:project-runner.debugProject",
    "onCommand:project-runner.runCommand",
    "onCommand:project-runner.pickCommand",
    "onCommand:project-runner.stopCommand",
    "onCommand:project-runner.configureCommand"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "project-runner.runProject",
        "title": "Universal Project Runner: Run Project",
        "icon": "$(play)"
      },
      {
        "command": "project-runner.debugProject",
        "title": "Universal Project Runner: Debug Project",
        "icon": "$(debug-alt)"
      },
      {
        "command": "project-runner.runCommand",
        "title": "Universal Project Runner: Run Command",
        "icon": "$(run-coverage)"
      },
      {
        "command": "project-runner.pickCommand",
        "title": "Universal Project Runner: Select Command",
        "icon": {
          "light": "resources/play-dropdown.svg",
          "dark": "resources/play-dropdown.svg"
        }
      },
      {
        "command": "project-runner.stopCommand",
        "title": "Universal Project Runner: Stop Project",
        "icon": "$(debug-stop)"
      },
      {
        "command": "project-runner.configureCommand",
        "title": "Universal Project Runner: Configure Run Command",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "project-runner.runProject",
          "when": "universalProjectRunner.action.run && !universalProjectRunner.commandRunning",
          "group": "navigation@1"
        },
        {
          "command": "project-runner.debugProject",
          "when": "universalProjectRunner.action.debug && !universalProjectRunner.commandRunning",
          "group": "navigation@2"
        },
        {
          "command": "project-runner.runCommand",
          "when": "universalProjectRunner.hasSingleCommandAction && !universalProjectRunner.commandRunning",
          "group": "navigation@3"
        },
        {
          "command": "project-runner.pickCommand",
          "when": "universalProjectRunner.hasMultipleCommandActions && !universalProjectRunner.commandRunning",
          "group": "navigation@3"
        },
        {
          "command": "project-runner.stopCommand",
          "when": "universalProjectRunner.commandRunning",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "project-runner.runProject"
        },
        {
          "command": "project-runner.debugProject"
        },
        {
          "command": "project-runner.runCommand"
        },
        {
          "command": "project-runner.stopCommand"
        },
        {
          "command": "project-runner.configureCommand"
        }
      ]
    },
    "configuration": {
      "title": "Universal Project Runner",
      "properties": {
        "universalProjectRunner.terminalName": {
          "type": "string",
          "default": "Universal Project Runner",
          "description": "Base name of the terminal used by Universal Project Runner."
        },
        "universalProjectRunner.action.run": {
          "type": "boolean",
          "default": true,
          "description": "Show the Universal Project Runner run action. This action starts VS Code running without debugging."
        },
        "universalProjectRunner.action.debug": {
          "type": "boolean",
          "default": true,
          "description": "Show the Universal Project Runner debug action. This action starts VS Code debugging."
        },
        "universalProjectRunner.commands": {
          "type": "array",
          "default": [],
          "description": "Named terminal commands available to Universal Project Runner.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name shown in the command picker."
              },
              "cwd": {
                "type": "string",
                "default": "",
                "description": "Optional working directory. Relative paths are resolved from the workspace folder."
              },
              "command": {
                "type": "string",
                "description": "Terminal command to run."
              }
            }
          }
        },
        "universalProjectRunner.statusBar.showRun": {
          "type": "boolean",
          "default": true,
          "description": "Show the Universal Project Runner run action in the status bar."
        },
        "universalProjectRunner.statusBar.showDebug": {
          "type": "boolean",
          "default": false,
          "description": "Show the Universal Project Runner debug action in the status bar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.107.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
