{
  "name": "universal-project-runner",
  "displayName": "Universal Project Runner",
  "description": "Run projects from VS Code using configurable project commands.",
  "version": "0.1.0",
  "publisher": "daoudaslam",
  "icon": "resources/project-runner.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/daoudaslam2/project-runner"
  },
  "bugs": {
    "url": "https://github.com/daoudaslam2/project-runner/issues"
  },
  "homepage": "https://github.com/daoudaslam2/project-runner#readme",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:project-runner.runProject",
    "onCommand:project-runner.debugProject",
    "onCommand:project-runner.runCommand",
    "onCommand:project-runner.stopCommand",
    "onCommand:project-runner.configureCommand"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "project-runner.runProject",
        "title": "Project Runner: Run Project",
        "icon": "$(play)"
      },
      {
        "command": "project-runner.debugProject",
        "title": "Project Runner: Debug Project",
        "icon": "$(debug-alt)"
      },
      {
        "command": "project-runner.runCommand",
        "title": "Project Runner: Run Command",
        "icon": "$(run-coverage)"
      },
      {
        "command": "project-runner.stopCommand",
        "title": "Project Runner: Stop Project",
        "icon": "$(debug-stop)"
      },
      {
        "command": "project-runner.configureCommand",
        "title": "Project Runner: Configure Run Command",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "project-runner.runProject",
          "when": "projectRunner.action.run && !projectRunner.commandRunning",
          "group": "navigation@1"
        },
        {
          "command": "project-runner.debugProject",
          "when": "projectRunner.action.debug && !projectRunner.commandRunning",
          "group": "navigation@2"
        },
        {
          "command": "project-runner.runCommand",
          "when": "projectRunner.hasCommandAction && !projectRunner.commandRunning",
          "group": "navigation@3"
        },
        {
          "command": "project-runner.stopCommand",
          "when": "projectRunner.commandRunning",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "project-runner.runProject"
        },
        {
          "command": "project-runner.debugProject"
        },
        {
          "command": "project-runner.runCommand"
        },
        {
          "command": "project-runner.stopCommand"
        },
        {
          "command": "project-runner.configureCommand"
        }
      ]
    },
    "configuration": {
      "title": "Project Runner",
      "properties": {
        "projectRunner.cwd": {
          "type": "string",
          "default": "",
          "description": "Optional working directory for the run command. Relative paths are resolved from the workspace folder."
        },
        "projectRunner.terminalName": {
          "type": "string",
          "default": "Project Runner",
          "description": "Name of the terminal used by Project Runner."
        },
        "projectRunner.action.run": {
          "type": "boolean",
          "default": true,
          "description": "Show the Project Runner run action. This action starts VS Code running without debugging."
        },
        "projectRunner.action.debug": {
          "type": "boolean",
          "default": true,
          "description": "Show the Project Runner debug action. This action starts VS Code debugging like F5."
        },
        "projectRunner.action.command": {
          "type": "string",
          "default": "",
          "description": "Optional terminal command action. When empty, the command button is hidden. When set, Project Runner shows a separate command button that runs this text in the terminal."
        },
        "projectRunner.statusBar.showRun": {
          "type": "boolean",
          "default": true,
          "description": "Show the Project Runner run action in the status bar."
        },
        "projectRunner.statusBar.showDebug": {
          "type": "boolean",
          "default": false,
          "description": "Show the Project Runner debug action in the status bar."
        },
        "projectRunner.statusBar.showCommand": {
          "type": "boolean",
          "default": false,
          "description": "Show the Project Runner custom command action in the status bar when projectRunner.action.command is set."
        },
        "projectRunner.statusBar.showStopCommand": {
          "type": "boolean",
          "default": true,
          "description": "Show the Project Runner stop action in the status bar while a Project Runner action is running."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.110.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
